{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": [
        "arn:aws:iot:us-east-2:243809381986:client/puerta-mascotas-01",
        "arn:aws:iot:us-east-2:243809381986:client/mqttfx-puerta-mascotas-01"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": [
        "arn:aws:iot:us-east-2:243809381986:topic/$aws/things/puerta-mascotas-01/shadow/get",
        "arn:aws:iot:us-east-2:243809381986:topic/$aws/things/puerta-mascotas-01/shadow/update"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:us-east-2:243809381986:topicfilter/$aws/things/puerta-mascotas-01/shadow/get/accepted",
        "arn:aws:iot:us-east-2:243809381986:topicfilter/$aws/things/puerta-mascotas-01/shadow/get/rejected",
        "arn:aws:iot:us-east-2:243809381986:topicfilter/$aws/things/puerta-mascotas-01/shadow/update/delta",
        "arn:aws:iot:us-east-2:243809381986:topicfilter/$aws/things/puerta-mascotas-01/shadow/update/accepted",
        "arn:aws:iot:us-east-2:243809381986:topicfilter/$aws/things/puerta-mascotas-01/shadow/update/rejected"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": [
        "arn:aws:iot:us-east-2:243809381986:topic/$aws/things/puerta-mascotas-01/shadow/get/accepted",
        "arn:aws:iot:us-east-2:243809381986:topic/$aws/things/puerta-mascotas-01/shadow/get/rejected",
        "arn:aws:iot:us-east-2:243809381986:topic/$aws/things/puerta-mascotas-01/shadow/update/delta",
        "arn:aws:iot:us-east-2:243809381986:topic/$aws/things/puerta-mascotas-01/shadow/update/accepted",
        "arn:aws:iot:us-east-2:243809381986:topic/$aws/things/puerta-mascotas-01/shadow/update/rejected"
      ]
    }
  ]
}